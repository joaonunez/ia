# Copia este archivo como .env y completa los valores reales ahi.
# El archivo .env NUNCA se sube al repositorio (esta excluido en .gitignore).

# Secreto: clave de la API de Gemini (puede quedar vacia para modo simulado local).
GEMINI_API_KEY=
API_KEY=

# Configuracion: desarrollo o produccion.
ENTORNO=desarrollo

# Configuracion: simulado (por omision) o real.
MODELO=simulado

# Configuracion: 0 (no permite respaldo, falla con 503) o 1 (permite ModeloRespaldo).
PERMITIR_RESPALDO=0
